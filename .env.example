# ==============================================================================
# GharYahan - Hyperlocal Rental Marketplace (Pakistan)
# Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Duplicate this file and rename it to ".env.local"
# 2. Replace the placeholder values with your real project credentials
# 3. For production (Vercel), add these exact keys in Vercel Project Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend-as-a-Service Configuration
# Find these in your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. Application Base URL
# - Local Development: http://localhost:3000
# - Production (Vercel): https://gharyahan.vercel.app (or custom domain)
# Critical for Supabase auth email confirmation and password reset callbacks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Node Environment
# Values: development | production | test
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. Master Platform Administrator Credentials (Server-Side Only)
# These credentials grant access to the /admin route and admin API endpoints.
# Never expose these with a NEXT_PUBLIC_ prefix.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@gharyahan.pk
ADMIN_PASSWORD=DemoAdminPass123!
ADMIN_ROLE=admin

